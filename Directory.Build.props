<Project>
  <Import Project="$(MSBuildThisFileDirectory)Stallion.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Stallion.Local.props')" />
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <CppWinRTPackageVersion>2.0.230706.1</CppWinRTPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != '' and '$(Platform)' != ''">
    <OutDir>$(SolutionDir)$(MSBuildProjectName)\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)$(MSBuildProjectName)\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <PropertyGroup>
    <WindowsAppSDKVerifyTransitiveDependencies>false</WindowsAppSDKVerifyTransitiveDependencies>
    <!-- Set the token values in an untracked Directory.Build.targets or CI properties. -->
    <StallionEnabled Condition="'$(StallionEnabled)' == ''">false</StallionEnabled>
  </PropertyGroup>
    <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.230706.1" />
  </ItemGroup>
</Project>
